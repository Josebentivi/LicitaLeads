APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

DATABASE_URL=sqlite:///./data/licita_lead.db

TIMEZONE=America/Sao_Paulo
DEFAULT_UF=MA
DEFAULT_LOOKBACK_DAYS=30
DEFAULT_MODALITIES=pregao_eletronico

PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_INTEGRATION_BASE_URL=https://pncp.gov.br/api/pncp/v1
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br

HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4
HTTP_MAX_CONCURRENCY=4
HTTP_USER_AGENT=LicitaLeadMonitor/0.1

DOCUMENT_STORAGE_PATH=./data/documents
RAW_DATA_STORAGE_PATH=./data/raw
DOCUMENT_MAX_BYTES=52428800
ARCHIVE_MAX_BYTES=209715200
ARCHIVE_MAX_MEMBERS=100
HOLIDAY_CALENDAR_PATH=./data/holidays.csv

LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_CHUNKS_PER_DOCUMENT=40
LLM_MIN_CHUNK_CHARACTERS=200

CONTACT_SEARCH_ENABLED=false
CONTACT_SEARCH_PROVIDER=none
CONTACT_SEARCH_API_KEY=

OUTREACH_MODE=draft_only
OUTREACH_SENDER_NAME="Equipe jurídica"
OUTREACH_LAW_FIRM="LicitaLead Monitor"
OUTREACH_SENDER_CONTACT="contato a configurar"

SCHEDULER_ENABLED=true
SCHEDULER_DISCOVERY_HOURS=6
SCHEDULER_ACTIVE_REFRESH_MINUTES=60
SCHEDULER_DOCUMENTS_HOURS=2
SCHEDULER_DEADLINES_MINUTES=30
SCHEDULER_CONTACTS_HOURS=24

DOCUMENT_BATCH_SIZE=30
CRAWL_MAX_RECORDS_PER_SOURCE=0
CRAWL_MAX_PAGES=0
CRAWL_STALE_AFTER_MINUTES=180

MIN_LEAD_SCORE=50
MANUAL_REVIEW_CONFIDENCE_THRESHOLD=0.75
RUN_LIVE_CONTRACT_TESTS=false
