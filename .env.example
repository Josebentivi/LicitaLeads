APP_ENV=development
LOG_LEVEL=INFO
TEST_SUITE_TIMEOUT_SECONDS=3600
APP_HOST=127.0.0.1
APP_PORT=8000
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

DATABASE_URL=sqlite:///./data/licita_lead.db

TIMEZONE=America/Sao_Paulo
DEFAULT_UF=MA
DEFAULT_LOOKBACK_DAYS=30
DEFAULT_MODALITIES=pregao_eletronico

PNCP_BASE_URL=https://pncp.gov.br/api/consulta/v1
PNCP_INTEGRATION_BASE_URL=https://pncp.gov.br/api/pncp/v1
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br

HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5
HTTP_MAX_CONCURRENCY=4
# Document downloads and isolated extraction/OCR processes. Restart the launcher after changes.
DOCUMENT_DOWNLOAD_CONCURRENCY=4
DOCUMENT_PROCESS_CONCURRENCY=2
HTTP_MIN_REQUEST_INTERVAL_SECONDS=0.5
HTTP_USER_AGENT=LicitaLeadMonitor/0.1

DOCUMENT_STORAGE_PATH=./data/documents
RAW_DATA_STORAGE_PATH=./data/raw
DOCUMENT_MAX_BYTES=52428800
ARCHIVE_MAX_BYTES=209715200
ARCHIVE_MAX_MEMBERS=100
# Dois níveis: ZIP externo e um ZIP interno; limites cumulativos em toda a árvore.
ARCHIVE_MAX_DEPTH=2
HOLIDAY_CALENDAR_PATH=./data/holidays.csv

LLM_ENABLED=false
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.6-luna
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=1200
LLM_MAX_CHUNKS_PER_DOCUMENT=40
LLM_MIN_CHUNK_CHARACTERS=200
# Fila independente: limite global, incluindo tentativas; preços em USD/1M tokens.
LLM_MAX_REQUESTS_PER_HOUR=500
LLM_INPUT_PRICE_PER_MILLION_USD=0.1
LLM_OUTPUT_PRICE_PER_MILLION_USD=0.5

CONTACT_SEARCH_ENABLED=false
CONTACT_SEARCH_PROVIDER=none
CONTACT_SEARCH_API_KEY=
CONTACT_DOMAIN_DISCOVERY_ENABLED=true

TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_TIMEOUT_SECONDS=30
TRANSPARENCIA_MAX_RETRIES=1
PAYMENT_SOURCES=transparencia,manual,municipal
MUNICIPAL_PAYMENT_SOURCES=sao_luis,imperatriz,timon,caxias,bacabal
MUNICIPAL_PAYMENT_INCLUDE_DETAILS=false
# Fontes municipais sem HTTPS comprovado exigem opt-in explicito.
ALLOW_INSECURE_HTTP_SOURCES=false
MUNICIPAL_PAYMENT_DETAIL_LIMIT=500
MUNICIPAL_PAYMENT_MAX_RECORDS=10000
SAO_LUIS_PAYMENTS_URL=https://www.saoluis.ma.gov.br/dados-abertos

OUTREACH_MODE=draft_only
OUTREACH_SENDER_NAME="Equipe jurídica"
OUTREACH_LAW_FIRM="LicitaLead Monitor"
OUTREACH_SENDER_CONTACT="contato a configurar"

SCHEDULER_ENABLED=true
SCHEDULER_DISCOVERY_HOURS=6
# Atas: coleta automatica ao iniciar o scheduler e depois a cada 24 horas.
SCHEDULER_PRICE_REGISTRY_HOURS=24
# Ausente: atas automaticas seguem DEFAULT_LOOKBACK_DAYS. Override opcional:
# PRICE_REGISTRY_LOOKBACK_DAYS=30
SCHEDULER_ACTIVE_REFRESH_MINUTES=60
SCHEDULER_DOCUMENTS_HOURS=2
SCHEDULER_DEADLINES_MINUTES=30
SCHEDULER_CONTACTS_HOURS=24

DOCUMENT_BATCH_SIZE=30
DOCUMENT_MAX_ATTEMPTS=5
DOCUMENT_RETRY_BASE_MINUTES=15
CRAWL_MAX_RECORDS_PER_SOURCE=50
CRAWL_MAX_PAGES=20
ACTIVE_REFRESH_BATCH_SIZE=25
COMPRAS_RECHECK_BATCH_SIZE=100
COLLECTION_INCREMENTAL_OVERLAP_DAYS=2
COLLECTION_RECONCILIATION_DAYS=7
CRAWL_STALE_AFTER_MINUTES=180
SESSION_POLL_ENABLED=true
SESSION_POLL_MINUTES=15
SESSION_POLL_DOCUMENT_LIMIT=20
PAYMENT_GRACE_DAYS=60
CONTRACT_AGENCY_CNPJS=
PAYMENT_POLL_CNPJS=
SCHEDULER_CONTRACT_HOURS=24
SCHEDULER_PAYMENT_HOURS=24
SCHEDULER_MUNICIPAL_PAYMENT_HOURS=24
OCR_ENABLED=false
OCR_PROVIDER=tesseract
OCR_LANGUAGE=por
OCR_DPI=200
OCR_MIN_CONFIDENCE=0.5

MIN_LEAD_SCORE=50
MANUAL_REVIEW_CONFIDENCE_THRESHOLD=0.75
RUN_LIVE_CONTRACT_TESTS=false

# Quantidade por transação em importações independentes de pagamentos
PAYMENT_INGESTION_BATCH_SIZE=250
